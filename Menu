-- =============================================
-- Cheat Menu by Grok | ESP + Assist + Movement
-- =============================================

local Menu = {
    Open = false,
    CurrentTab = 1,
}

-- Основная функция меню
function DrawMenu()
    if not Menu.Open then return end

    ImGui.Begin("Cheat Menu", true, ImGuiWindowFlags.NoCollapse | ImGuiWindowFlags.AlwaysAutoResize)

    -- Табы
    if ImGui.BeginTabBar("MainTabs") then
        if ImGui.BeginTabItem("ESP") then
            Menu.CurrentTab = 1
            ImGui.Separator()
            
            ImGui.Checkbox("Chams", Config.ESP.Chams)
            ImGui.Checkbox("Boxes", Config.ESP.Boxes)
            ImGui.Checkbox("Names", Config.ESP.Names)
            ImGui.Checkbox("Health", Config.ESP.Health)
            ImGui.Checkbox("Distance", Config.ESP.Distance)
            
            ImGui.EndTabItem()
        end

        if ImGui.BeginTabItem("Assist") then
            Menu.CurrentTab = 2
            ImGui.Separator()
            
            ImGui.Checkbox("Hitboxes", Config.Assist.Hitboxes)
            ImGui.Checkbox("Aimbot", Config.Assist.Aimbot)
            ImGui.Checkbox("Triggerbot", Config.Assist.Triggerbot)
            
            ImGui.EndTabItem()
        end

        if ImGui.BeginTabItem("Movement") then
            Menu.CurrentTab = 3
            ImGui.Separator()
            
            ImGui.Checkbox("Speed Hack", Config.Movement.SpeedHack)
            if Config.Movement.SpeedHack[1] then
                ImGui.SliderFloat("Speed", Config.Movement.Speed, 1.0, 10.0)
            end
            
            ImGui.Checkbox("NoClip", Config.Movement.NoClip)
            ImGui.Checkbox("Fly", Config.Movement.Fly)
            
            ImGui.EndTabItem()
        end
        ImGui.EndTabBar()
    end

    ImGui.Separator()
    if ImGui.Button("Закрыть меню") then
        Menu.Open = false
    end

    ImGui.End()
end

-- Конфиг
Config = Config or {
    ESP = {
        Chams = {false},
        Boxes = {true},
        Names = {false},
        Health = {false},
        Distance = {false},
    },
    Assist = {
        Hitboxes = {true},
        Aimbot = {false},
        Triggerbot = {false},
    },
    Movement = {
        SpeedHack = {false},
        Speed = {5.0},
        NoClip = {false},
        Fly = {false},
    }
}

-- Главный цикл
function OnUpdate()
    if ImGui.IsKeyPressed(ImGuiKey.Insert) then
        Menu.Open = not Menu.Open
    end

    DrawMenu()
end

