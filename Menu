-- ДИНАМИЧЕСКАЯ СИСТЕМА СОЗДАНИЯ ВКЛАДОК
----------------------------------------------------
local tabs = {}
local firstTab = true
local tabOrder = 1

local function CreateTab(tabName, icon)
    -- Кнопка во фрейме сайдбара
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0.9, 0, 0, 32)
    TabBtn.BackgroundColor3 = Color3.fromRGB(25, 27, 30)
    TabBtn.Text = (icon or "") .. " " .. tabName
    TabBtn.TextColor3 = Color3.fromRGB(140, 145, 150)
    TabBtn.TextSize = 13
    TabBtn.Font = Enum.Font.SourceSansBold
    TabBtn.Parent = Sidebar
    TabBtn.LayoutOrder = tabOrder
    tabOrder = tabOrder + 1
    
    local BtnCorner = Instance.new("UICorner") BtnCorner.CornerRadius = UDim.new(0, 5) BtnCorner.Parent = TabBtn

    -- Страница под эту вкладку (с вертикальным скроллом функций)
    local TabPage = Instance.new("ScrollingFrame")
    TabPage.Size = UDim2.new(1, 0, 1, 0)
    TabPage.BackgroundTransparency = 1
    TabPage.CanvasSize = UDim2.new(0, 0, 2, 0)
    TabPage.ScrollBarThickness = 3
    TabPage.Visible = false
    TabPage.Parent = ContentContainer

    local PageList = Instance.new("UIListLayout") PageList.Parent = TabPage; PageList.SortOrder = Enum.SortOrder.LayoutOrder; PageList.Padding = UDim.new(0, 6)

    if firstTab then
        TabBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
        TabBtn.TextColor3 = Accent_Color
        TabPage.Visible = true
        firstTab = false
    end

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            TweenService:Create(t.Btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(25, 27, 30), TextColor3 = Color3.fromRGB(140, 145, 150)}):Play()
        end
        TabPage.Visible = true
        TweenService:Create(TabBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 35, 45), TextColor3 = Accent_Color}):Play()
    end)

    table.insert(tabs, {Btn = TabBtn, Page = TabPage})
    return TabPage
end

